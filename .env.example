# Database (Neon Postgres). Use a connection string with ?sslmode=require.
DATABASE_URL=

# Auth.js v5
# Generate with: npx auth secret
AUTH_SECRET=
# Set to your deployment URL in production (e.g. https://rats.example.com).
# Optional in development; defaults to http://localhost:3000.
AUTH_URL=http://localhost:3000

# Email (Resend). Verify a domain or use onboarding@resend.dev for dev.
RESEND_API_KEY=
EMAIL_FROM="R.A.T.S. <noreply@rats.example.com>"

# Steam (OpenID 2.0 — no client secret needed).
# A Web API key from https://steamcommunity.com/dev/apikey is optional for fetching
# the user's display name/avatar after they log in via OpenID.
STEAM_API_KEY=

# Epic Games OAuth (https://dev.epicgames.com/portal/)
EPIC_CLIENT_ID=
EPIC_CLIENT_SECRET=

# Microsoft / Xbox Live OAuth
# Register a Microsoft "personal accounts" app at https://entra.microsoft.com.
# Use the live.com endpoints (handled by our routes) so personal Xbox accounts work.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
